{
  "name": "file-manager-client",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng build --configuration development --watch",
    "test": "npx testify",
    "test:watch": "npx testify --watch",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "check": "npm run test:unit && npm run build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/router": "22.1.2",
    "@codemirror/language-data": "^6.5.2",
    "@epikodelabs/actionstack": "^3.0.24",
    "@epikodelabs/streamix": "^2.0.52",
    "codemirror": "^6.0.2",
    "mediabunny": "^1.53.1",
    "music-metadata": "^11.14.0",
    "terminal-element": "^1.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@angular/core": "22.1.2",
    "@epikodelabs/testify": "^1.0.39",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
