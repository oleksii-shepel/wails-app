{
  "schemaVersion": 1,
  "id": "epikode.hash-tools",
  "name": "Hash Tools",
  "version": "1.0.0",
  "description": "Example manifest for a file-manager plugin package.",
  "author": "Epikode Labs",
  "apiVersion": "^1.0.0",
  "permissions": [
    "commands",
    "keybindings",
    "toolbar",
    "contextMenu",
    "filesystem.read"
  ],
  "activationEvents": [
    "onCommand:hash.sha256"
  ],
  "contributes": {
    "commands": [
      "hash.sha256"
    ]
  }
}
