{
  "name": "file-manager-client",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 3000",
    "dev": "ng serve --host 0.0.0.0 --port 3000",
    "build": "ng build --configuration production",
    "watch": "ng build --configuration development --watch",
    "test": "cd ../.. && npx testify --exclusive --project file-manager-client --config manager/frontend/testify.json",
    "test:watch": "cd ../.. && npx testify --exclusive --project file-manager-client --config manager/frontend/testify.json --watch",
    "test:ci": "npm run test -- --headless",
    "check": "npm run test && npm run build",
    "check:ci": "npm run test:ci && npm run build",
    "audit:theme": "node scripts/audit-theme-colors.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/router": "22.1.2",
    "@codemirror/language-data": "^6.5.2",
    "@epikodelabs/actionstack": "^3.0.24",
    "@epikodelabs/streamix": "^2.0.52",
    "@reassembly/core": "file:../../packages/core",
    "@reassembly/registry-plugin": "file:../../plugins/registry",
    "codemirror": "^6.0.2",
    "jasmine-core": "^6.0.0",
    "mediabunny": "^1.53.1",
    "music-metadata": "^11.14.0",
    "terminal-element": "^1.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@epikodelabs/testify": "^1.0.55",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.2.0",
    "typescript": "~6.0.3"
  }
}
