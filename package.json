{
  "name": "reassembly-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "manager/frontend",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "npm --prefix manager/frontend run build",
    "lint": "node --check server.js && npx tsc --noEmit -p manager/frontend/tsconfig.app.json"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "express": "^4.21.2"
  }
}
