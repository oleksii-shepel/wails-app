{
  "name": "reassembly-workspace",
  "private": true,
  "scripts": {
    "build:plugins": "npm run build --workspace @reassembly/registry-plugin",
    "build:frontend": "npm --prefix manager/frontend run build",
    "build:go": "go build ./manager/...",
    "build:app": "cd manager && wails build",
    "build": "npm run build:plugins && npm run build:app",
    "check": "npm run build:plugins && npm run build:frontend && npm run build:go",
    "test:plugins": "npm run test --workspace @reassembly/registry-plugin",
    "test:frontend": "npm --prefix manager/frontend test",
    "test:go": "go test ./manager/...",
    "test": "npm run test:plugins && npm run test:frontend && npm run test:go",
    "audit:registry": "node scripts/registry-boundary.mjs",
    "cleanup:registry": "node scripts/registry-boundary.mjs --fix"
  },
  "workspaces": [
    "manager/frontend",
    "plugins/*"
  ]
}
