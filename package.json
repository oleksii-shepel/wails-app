{
  "name": "reassembly-file-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "manager/frontend"
  ],
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "npm --prefix manager/frontend run build",
    "build:dev": "npm --prefix manager/frontend run ng -- build --configuration development",
    "lint": "npx tsc -p manager/frontend/tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "express": "^4.21.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.4"
  }
}
