{
  "name": "@reassembly/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/frontend/index.js",
  "types": "./dist/frontend/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/frontend/index.d.ts",
      "default": "./dist/frontend/index.js"
    },
    "./contracts/files": {
      "types": "./dist/frontend/contracts/files/index.d.ts",
      "default": "./dist/frontend/contracts/files/index.js"
    },
    "./contracts/input": {
      "types": "./dist/frontend/contracts/input/index.d.ts",
      "default": "./dist/frontend/contracts/input/index.js"
    },
    "./contracts/sources": {
      "types": "./dist/frontend/contracts/sources/index.d.ts",
      "default": "./dist/frontend/contracts/sources/index.js"
    },
    "./contracts/panes": {
      "types": "./dist/frontend/contracts/panes/index.d.ts",
      "default": "./dist/frontend/contracts/panes/index.js"
    },
    "./runtime/panes": {
      "types": "./dist/frontend/runtime/panes/index.d.ts",
      "default": "./dist/frontend/runtime/panes/index.js"
    },
    "./files": {
      "types": "./dist/frontend/contracts/files/index.d.ts",
      "default": "./dist/frontend/contracts/files/index.js"
    },
    "./input": {
      "types": "./dist/frontend/contracts/input/index.d.ts",
      "default": "./dist/frontend/contracts/input/index.js"
    },
    "./sources": {
      "types": "./dist/frontend/contracts/sources/index.d.ts",
      "default": "./dist/frontend/contracts/sources/index.js"
    },
    "./panes": {
      "types": "./dist/frontend/contracts/panes/index.d.ts",
      "default": "./dist/frontend/contracts/panes/index.js"
    },
    "./renderer": {
      "types": "./dist/frontend/runtime/panes/index.d.ts",
      "default": "./dist/frontend/runtime/panes/index.js"
    },
    "./ui/panes": {
      "types": "./dist/frontend/ui/panes/index.d.ts",
      "default": "./dist/frontend/ui/panes/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "contracts/files": [
        "dist/frontend/contracts/files/index.d.ts"
      ],
      "contracts/input": [
        "dist/frontend/contracts/input/index.d.ts"
      ],
      "contracts/sources": [
        "dist/frontend/contracts/sources/index.d.ts"
      ],
      "contracts/panes": [
        "dist/frontend/contracts/panes/index.d.ts"
      ],
      "runtime/panes": [
        "dist/frontend/runtime/panes/index.d.ts"
      ],
      "files": [
        "dist/frontend/contracts/files/index.d.ts"
      ],
      "input": [
        "dist/frontend/contracts/input/index.d.ts"
      ],
      "sources": [
        "dist/frontend/contracts/sources/index.d.ts"
      ],
      "panes": [
        "dist/frontend/contracts/panes/index.d.ts"
      ],
      "renderer": [
        "dist/frontend/runtime/panes/index.d.ts"
      ],
      "ui/panes": [
        "dist/frontend/ui/panes/index.d.ts"
      ],
      "*": [
        "dist/frontend/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/frontend"
  ],
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "ngc -p tsconfig.json",
    "test": "npm run test:frontend",
    "test:frontend": "ngc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@angular/core": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/compiler-cli": "22.1.2"
  },
  "peerDependencies": {
    "@angular/core": "22.1.2"
  }
}
