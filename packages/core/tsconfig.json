{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "frontend/src",
    "outDir": "dist/frontend",
    "verbatimModuleSyntax": true
  },
  "include": [
    "frontend/src/**/*.ts"
  ]
}
