{
  "schemaVersion": 2,
  "id": "reassembly.registry",
  "name": "Windows Registry",
  "version": "1.3.2",
  "apiVersion": "^2.0.0",
  "description": "Windows Registry provider with Registry-owned source semantics and native backend; Manager supplies the shared pane presentation.",
  "target": {
    "os": "windows",
    "arch": "x64"
  },
  "frontend": {
    "entry": "frontend/index.js"
  },
  "backend": {
    "entry": "backend/plugin.exe",
    "protocol": 1,
    "privilege": "elevated"
  },
  "permissions": [
    "panelSources",
    "backend.execute"
  ],
  "activationEvents": [
    "onScheme:registry"
  ],
  "contributes": {
    "schemes": [
      "registry"
    ]
  }
}
