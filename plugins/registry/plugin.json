{
  "schemaVersion": 2,
  "id": "reassembly.registry",
  "name": "Windows Registry",
  "version": "1.2.0",
  "apiVersion": "^2.0.0",
  "description": "Windows Registry browser and editor with plugin-owned frontend UX and native backend. The registry:// scheme exists only while this plugin is active.",
  "target": {
    "os": "windows",
    "arch": "x64"
  },
  "frontend": {
    "entry": "frontend/index.js"
  },
  "backend": {
    "entry": "backend/plugin.exe",
    "protocol": 1
  },
  "permissions": [
    "commands",
    "toolbar",
    "contextMenu",
    "panelSources",
    "schemes",
    "dialogs",
    "backend.execute"
  ],
  "activationEvents": [
    "onScheme:registry",
    "onCommand:reassembly.registry.open"
  ],
  "contributes": {
    "schemes": [
      "registry"
    ],
    "commands": [
      "reassembly.registry.newKey",
      "reassembly.registry.newValue",
      "reassembly.registry.edit",
      "reassembly.registry.delete",
      "reassembly.registry.open",
      "reassembly.registry.open.currentUser",
      "reassembly.registry.open.localMachine",
      "reassembly.registry.open.classesRoot",
      "reassembly.registry.open.users",
      "reassembly.registry.open.currentConfig"
    ]
  }
}
